<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- netstandard2.0：供 net8 预览器/工具引用；net461：供 net48 Shell 引用，
         使 Shell 运行时绑定到 4.1.4.0 门面，规避 netstandard2.0 契约版本(4.1.3.0)与门面不符的 0x80131040 -->
    <TargetFrameworks>netstandard2.0;net461</TargetFrameworks>
    <LangVersion>9</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>_3DThumbnailShell.Core</RootNamespace>
    <AssemblyName>3DThumbnailShell.Core</AssemblyName>
    <!-- 与 Shell/CoreVerify 同钥强命名：避免强命名程序集引用弱命名依赖时的绑定失败(0x80131044) -->
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>key.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>
  <ItemGroup>
    <!-- 仅 netstandard2.0 需要该包；net461 用 .NET Framework 自带的 System.Numerics.Vectors 4.0.0.0（GAC 必有），
         否则 mscoree 托管 COM 激活时按 GAC 找不到 4.1.4.0 门面 → 0x80131522 类型加载失败 -->
    <PackageReference Include="System.Numerics.Vectors" Version="4.5.0" Condition="'$(TargetFramework)' == 'netstandard2.0'" />
    <!-- 无 VS 环境下用 dotnet SDK 编译 net461 所需的编译期引用程序集 -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <!-- net461 默认引用集不含压缩/XML 程序集，需显式引用 -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net461'">
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.Xml.Linq" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="CoreVerify, " />
  </ItemGroup>
</Project>